# Base de datos (ver docker-compose.yml)
DATABASE_URL="postgresql://devtracker:devtracker@localhost:5432/devtracker?schema=public"

# Puerto de la API REST
PORT=3000

# Origen permitido para CORS (Angular dev)
CORS_ORIGIN=http://localhost:4200

# URL del frontend (para enlaces en correos)
FRONTEND_URL=http://localhost:4200

# URL de la API (para OAuth redirects)
API_URL=http://localhost:3000

# Auth JWT (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="cambiar-en-produccion"
JWT_REFRESH_SECRET="cambiar-en-produccion"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# SMTP (para envío de correos de invitación)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="tu-contraseña-de-aplicacion"
SMTP_FROM="no-reply@devtracker.app"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OAuth - Facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
